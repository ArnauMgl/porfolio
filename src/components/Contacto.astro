---
// Panel de contacto (modal). Se incluye una sola vez en la plantilla base.
// Comportamiento en src/scripts/contacto.js. Sin JavaScript, los enlaces [data-contacto] siguen siendo mailto:.
const email = 'hola@arnaularripa.com';
const linkedin = 'https://www.linkedin.com/in/arnaularripa/';
const ico = { fill: 'none', stroke: 'currentColor', 'stroke-width': 16, 'stroke-linecap': 'round', 'stroke-linejoin': 'round', 'aria-hidden': 'true' };
---
<dialog class="ds-contact" id="contacto" aria-labelledby="contacto-titulo" aria-modal="true">
<div class="ds-contact__panel">

<button type="button" class="ds-close" data-cerrar aria-label="Cerrar formulario de contacto">
<svg class="ds-icon" viewBox="0 0 256 256" {...ico}><line x1="200" y1="56" x2="56" y2="200"></line><line x1="200" y1="200" x2="56" y2="56"></line></svg>
</button>

<!-- Vista 1: formulario -->
<h2 class="ds-contact__title t-page-title-mobile" id="contacto-titulo" data-vista="form">Hola<span class="ds-dot">.</span></h2>
<p class="ds-contact__lead t-body" data-vista="form">Cuéntame qué oportunidad tienes en mente.</p>
<p class="ds-contact__note t-meta" data-vista="form">Todos los campos son obligatorios.</p>

<div class="ds-alert" id="contacto-alerta" role="alert" data-vista="form"></div>

<form class="ds-contact__form" id="contacto-form" method="post" action="/api/contact" novalidate data-vista="form">
<div class="ds-field">
<label class="ds-field__label t-body-strong" for="contacto-nombre">Nombre</label>
<input class="ds-field__input t-body" id="contacto-nombre" type="text" name="name" autocomplete="name" autofocus required>
<div class="ds-error" id="contacto-nombre-error" aria-live="polite"></div>
</div>
<div class="ds-field">
<label class="ds-field__label t-body-strong" for="contacto-email">Email</label>
<input class="ds-field__input t-body" id="contacto-email" type="email" name="email" autocomplete="email" inputmode="email" required>
<div class="ds-error" id="contacto-email-error" aria-live="polite"></div>
</div>
<div class="ds-field">
<label class="ds-field__label t-body-strong" for="contacto-mensaje">Mensaje</label>
<textarea class="ds-field__input ds-field__input--area t-body" id="contacto-mensaje" name="message" rows="4" required></textarea>
<div class="ds-error" id="contacto-mensaje-error" aria-live="polite"></div>
</div>
<!-- Cloudflare Turnstile (antispam). Normalmente vacío; solo aparece si Cloudflare pide una comprobación. -->
<div class="ds-contact__turnstile" id="contacto-turnstile"></div>
<!-- Campo trampa: debe llegar vacío -->
<div class="ds-hp" aria-hidden="true"><label>Web<input type="text" name="website" tabindex="-1" autocomplete="off"></label></div>
</form>

<!-- Vista 2: enviado con éxito -->
<div class="ds-contact__done" role="status" data-vista="exito" hidden>
<svg class="ds-contact__check" viewBox="0 0 256 256" {...ico}><circle cx="128" cy="128" r="96"></circle><polyline points="88 136 112 160 168 104"></polyline></svg>
<h2 class="ds-contact__title t-page-title-mobile" id="contacto-titulo-exito" tabindex="-1">Mensaje enviado<span class="ds-dot">.</span></h2>
<p class="t-body ds-contact__done-text" id="contacto-gracias"></p>
<p class="t-body ds-contact__done-more">Suelo contestar en uno o dos días laborables. Si no ves mi respuesta, mira en la carpeta de spam.</p>
<div><button type="button" class="ds-btn-secondary t-button" data-cerrar>Cerrar</button></div>
<div class="ds-contact__after">
<p class="t-meta ds-label">Mientras tanto</p>
<a class="ds-link ds-link--touch t-body" href={linkedin} target="_blank" rel="noopener" aria-label="LinkedIn de Arnau Larripa (se abre en una pestaña nueva)">LinkedIn<svg class="ds-icon" viewBox="0 0 256 256" {...ico}><line x1="64" y1="192" x2="192" y2="64"></line><polyline points="88 64 192 64 192 168"></polyline></svg></a>
</div>
</div>

<!-- Botón de envío (fijo al pie en móvil) -->
<div class="ds-contact__foot" data-vista="form">
<button type="submit" form="contacto-form" class="ds-btn t-button ds-contact__submit" id="contacto-enviar">
<span class="ds-contact__submit-label">Enviar mensaje</span>
<svg class="ds-icon ds-contact__arrow" viewBox="0 0 256 256" {...ico}><line x1="40" y1="128" x2="216" y2="128"></line><polyline points="144 56 216 128 144 200"></polyline></svg>
<svg class="ds-icon ds-contact__spinner" viewBox="0 0 256 256" {...ico}><path d="M128 32a96 96 0 1 0 96 96"></path></svg>
</button>
<p class="t-meta ds-contact__privacy">Usaré tus datos solo para responderte.</p>
</div>

<!-- Contacto directo -->
<section class="ds-contact__direct" aria-labelledby="contacto-directo" data-vista="form">
<p class="t-meta ds-label" id="contacto-directo">O escríbeme directamente</p>
<p class="t-subhead ds-contact__email" id="contacto-email-texto">{email}</p>
<div class="ds-actions ds-contact__direct-actions">
<button type="button" class="ds-btn-secondary t-button" data-copiar>
<svg class="ds-icon" viewBox="0 0 256 256" {...ico}><rect x="40" y="88" width="128" height="128" rx="8"></rect><polyline points="168 88 168 40 216 40 216 168 168 168"></polyline></svg>
<span>Copiar email</span>
</button>
<a class="ds-link ds-link--touch t-body" href={linkedin} target="_blank" rel="noopener" aria-label="LinkedIn de Arnau Larripa (se abre en una pestaña nueva)">LinkedIn<svg class="ds-icon" viewBox="0 0 256 256" {...ico}><line x1="64" y1="192" x2="192" y2="64"></line><polyline points="88 64 192 64 192 168"></polyline></svg></a>
</div>
<p class="ds-sr" role="status" id="contacto-copia"></p>
</section>

<p class="ds-sr" role="status" id="contacto-estado"></p>
</div>
</dialog>
