---
import Imagen from '../Imagen.astro';
import FilaArticulo from './FilaArticulo.astro';
import { Image } from 'astro:assets';
// Página de un artículo: cabecera, ficha, divisor, portada, cuerpo con barra de progreso y «Sigue leyendo».
// El cuerpo (art.html) sale del Markdown ya convertido a HTML; el texto no se toca.
interface Props { art: any; siguiente: any[]; }
const { art, siguiente } = Astro.props;

// Barra de progreso de lectura: OCULTA hasta que se diseñe la nueva. Para volver a activarla, poner true
// (la barra antigua, con sus estilos en wip.css y src/scripts/blog-lectura.js, es la que se activaría).
const MOSTRAR_PROGRESO = false;
---
<main id="articulo">
<article class="ds-wrap bl-articulo" data-lectura>
{MOSTRAR_PROGRESO && art.secciones.length > 0 && (
<div class="bl-rail">
<div class="bl-progress" role="progressbar" aria-label="Progreso de lectura" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" data-progreso><div class="bl-progress__fill" data-relleno></div></div>
<ol class="bl-marks">
{art.secciones.map((s) => <li class="bl-mark" data-seccion={s.id}><a class="bl-mark__dot" href={`#${s.id}`} aria-label={`Ir a la sección ${s.n}: ${s.texto}`}></a></li>)}
</ol>
</div>
)}
<header class="bl-cab ds-case-head">
<div class="ds-prose">
<a class="ds-link ds-link--touch t-body bl-volver" href="/blog/"><svg class="ds-icon" viewBox="0 0 256 256" fill="none" stroke="currentColor" stroke-width="16" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="216" y1="128" x2="40" y2="128"></line><polyline points="112 56 40 128 112 200"></polyline></svg>Volver al blog</a>
<h1 class="ds-case__title t-page-title-mobile" data-titulo>{art.titulo}<span class="ds-dot" aria-hidden="true">.</span></h1>
<p class="ds-case__subtitle t-statement">{art.descripcion}</p>
</div>
<dl class="ds-meta">
<div class="ds-meta__item"><dt class="t-meta">Publicado</dt><dd class="t-body-strong"><time datetime={art.fecha}>{art.fechaTexto}</time></dd></div>
<div class="ds-meta__item"><dt class="t-meta">Lectura</dt><dd class="t-body-strong">{art.lectura} min</dd></div>
{art.filtros.length > 0 && <div class="ds-meta__item"><dt class="t-meta">Palabras clave</dt><dd class="t-body-strong">{art.filtros.map((f) => f.nombre).join(', ')}</dd></div>}
{art.autor && <div class="ds-meta__item"><dt class="t-meta">Autor</dt><dd class="t-body-strong">{art.autor.nombre}</dd></div>}
</dl>
</header>

<div class="bl-body" data-cuerpo>
{art.portada && (
<figure class="ds-figure bl-portada">
<Imagen src={art.portada.meta} alt={art.portada.alt} loading="eager" tamano="columna" />
{art.portada.pie && <figcaption class="t-meta">{art.portada.pie}</figcaption>}
</figure>
)}
<div class="bl-cuerpo ds-prose t-body" set:html={art.html} />
{art.autor && (
<aside class="bl-autor" aria-label="Sobre quien firma el artículo">
{art.autor.fotoMeta && <Image class="bl-autor__foto" src={art.autor.fotoMeta} alt="" width={120} height={120} widths={[120, 240]} sizes="120px" format="webp" quality={85} loading="lazy" decoding="async" />}
<div class="bl-autor__datos">
<p class="bl-autor__label t-meta">Escrito por</p>
<p class="bl-autor__nombre t-subhead">{art.autor.nombre}</p>
{art.autor.rol && <p class="bl-autor__rol t-body">{art.autor.rol}</p>}
{art.autor.bio && <p class="bl-autor__bio t-body">{art.autor.bio}</p>}
{(art.autor.linkedin || art.autor.portfolio) && (
<ul class="bl-autor__enlaces">
{art.autor.linkedin && <li><a class="ds-link ds-link--touch t-body" href={art.autor.linkedin} target="_blank" rel="noopener" aria-label={`LinkedIn de ${art.autor.nombre} (se abre en una pestaña nueva)`}>LinkedIn<svg class="ds-icon" viewBox="0 0 256 256" fill="none" stroke="currentColor" stroke-width="16" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="64" y1="192" x2="192" y2="64"></line><polyline points="88 64 192 64 192 168"></polyline></svg></a></li>}
{art.autor.portfolio && <li><a class="ds-link ds-link--touch t-body" href={art.autor.portfolio} target="_blank" rel="noopener" aria-label={`Portfolio de ${art.autor.nombre} (se abre en una pestaña nueva)`}>Portfolio<svg class="ds-icon" viewBox="0 0 256 256" fill="none" stroke="currentColor" stroke-width="16" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="64" y1="192" x2="192" y2="64"></line><polyline points="88 64 192 64 192 168"></polyline></svg></a></li>}
</ul>
)}
</div>
</aside>
)}
</div>
{MOSTRAR_PROGRESO && <div class="bl-edge" aria-hidden="true" data-borde><div class="bl-edge__fill" data-borde-relleno></div></div>}
</article>

{siguiente.length > 0 && (
<section class="ds-wrap ds-case-section bl-mas" aria-labelledby="mas-titulo">
<div class="ds-section__head"><h2 class="ds-section-title t-section-title-mobile" id="mas-titulo">Sigue leyendo</h2></div>
<ol class="bl-list">
{siguiente.map((a) => <FilaArticulo art={a} nivelTitulo="h3" />)}
</ol>
<p class="bl-more"><a class="ds-link ds-link--touch t-body" href="/blog/">Ver todos los artículos<svg class="ds-icon" viewBox="0 0 256 256" fill="none" stroke="currentColor" stroke-width="16" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="40" y1="128" x2="216" y2="128"></line><polyline points="144 56 216 128 144 200"></polyline></svg></a></p>
</section>
)}
</main>
{MOSTRAR_PROGRESO && <script>import '../../scripts/blog-lectura.js';</script>}
