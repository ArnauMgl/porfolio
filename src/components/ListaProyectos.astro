---
import Imagen from './Imagen.astro';
// Lista numerada de proyectos, común a la Home y a «Trabajo seleccionado».
//   indice: formato de listado (miniatura al lado del texto en escritorio). Lo usan Home y Trabajo
//   primeraEager: la primera miniatura se carga sin diferir (para cuando se ve en la primera pantalla)
//   actual: ruta del caso que se está leyendo; se marca con «Estás aquí» (lo usan las páginas de caso)
import { proyectos } from '../data/proyectos.js';
//   nivelTitulo: etiqueta del título de cada proyecto (h2 en «Trabajo», donde no hay h2 antes; h3 en el resto). El aspecto es el mismo.
interface Props { indice?: boolean; primeraEager?: boolean; actual?: string; nivelTitulo?: 'h2' | 'h3'; }
const { indice = false, primeraEager = false, actual, nivelTitulo = 'h3' } = Astro.props;
const Titulo = nivelTitulo;
---
<ol class:list={['ds-work', { 'ds-work--index': indice }]}>
{proyectos.map((p, i) => (
<li>
<a class="ds-proj" href={p.href} aria-current={p.href === actual ? 'page' : undefined}>
<div class="ds-proj__row">
<span class="ds-proj__dot" aria-hidden="true"></span>
<div class="ds-proj__main"><Titulo class="ds-proj__title t-project-title-mobile"><span>{p.titulo}</span></Titulo><p class="ds-proj__desc t-body">{p.desc}</p><ul class="ds-proj__tags" aria-label="Sector y estado">{p.etiquetas.map((e) => <li class="ds-label-tag t-meta">{e}</li>)}{p.href === actual && <li><span class="ds-tag t-meta">Estás aquí</span></li>}</ul></div>
<svg class="ds-proj__arrow" viewBox="0 0 256 256" fill="none" stroke="currentColor" stroke-width="16" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="64" y1="192" x2="192" y2="64"></line><polyline points="88 64 192 64 192 168"></polyline></svg>
</div>
<div class="ds-proj__thumb">
<Imagen src={p.img} alt="" tamano={indice ? 'miniatura' : 'columna'} loading={primeraEager && i === 0 ? 'eager' : 'lazy'} />
</div>
</a>
</li>
))}
</ol>
