---
import Imagen from '../../components/Imagen.astro';
// Caso de estudio: eSBARD Edu. Marcado del artboard «CaseStudyMobile» (diseno/CaseStudyMobile.dc.html), con rutas reales.
// La portada se ve en la primera pantalla y no se difiere; el resto de imágenes se cargan al acercarse.
import Base from '../../layouts/Base.astro';
import ListaProyectos from '../../components/ListaProyectos.astro';
import portada from '../../assets/proyectos/esbard-edu.webp';
import mapaWireframes from '../../assets/esbard-edu/mapa-wireframes.webp';
import wireframeUsuarios from '../../assets/esbard-edu/wireframe-usuarios.webp';
import pantallaUsuarios from '../../assets/esbard-edu/pantalla-usuarios.webp';
import dsFundamentos from '../../assets/esbard-edu/ds-fundamentos.webp';
import dsComponentes from '../../assets/esbard-edu/ds-componentes.webp';
import contrasteTexto from '../../assets/esbard-edu/contraste-texto.webp';
import contrasteAcento from '../../assets/esbard-edu/contraste-acento.webp';
import portatilUsuarios from '../../assets/esbard-edu/portatil-usuarios.webp';
import laboratorios from '../../assets/esbard-edu/laboratorios.webp';
import retosCtf from '../../assets/esbard-edu/retos-ctf.webp';
import plantillas from '../../assets/esbard-edu/plantillas.webp';
---
<Base
  imagen="/og/og-esbard-edu.jpg"
  imagenAlt="Caso de estudio: eSBARD Edu, por Arnau Larripa"
  title="eSBARD Edu · Arnau Larripa"
  description="Caso de estudio: cómo diseñamos eSBARD Edu, una plataforma de formación práctica en ciberseguridad, a partir de los wireframes técnicos de su creador."
  actual="caso"
>
<main id="caso">

<section class="ds-wrap ds-case-head" aria-labelledby="caso-titulo">
<div class="ds-prose">
<h1 id="caso-titulo" class="ds-case__title t-page-title-mobile">eSBARD Edu</h1>
<p class="ds-case__subtitle t-statement">De los wireframes de un experto a una plataforma que se entiende</p>
<p class="t-body">Diseñamos la experiencia de una plataforma de formación práctica en ciberseguridad, traduciendo la visión muy técnica de su creador en flujos claros para los formadores que preparan los ejercicios de su alumnado.</p>
<dl class="ds-meta">
<div class="ds-meta__item"><dt class="t-meta"><svg class="ds-icon" viewBox="0 0 256 256" fill="none" stroke="currentColor" stroke-width="16" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="128" cy="128" r="96"></circle><polyline points="128 72 128 128 184 128"></polyline></svg>Duración</dt><dd class="t-body is-key">Entre mes y medio y 2 meses de diseño</dd></div>
<div class="ds-meta__item"><dt class="t-meta"><svg class="ds-icon" viewBox="0 0 256 256" fill="none" stroke="currentColor" stroke-width="16" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="48" y="48" width="64" height="64" rx="8"></rect><rect x="144" y="48" width="64" height="64" rx="8"></rect><rect x="48" y="144" width="64" height="64" rx="8"></rect><rect x="144" y="144" width="64" height="64" rx="8"></rect></svg>Sector</dt><dd class="t-body is-key">Ciberseguridad · Educación</dd></div>
<div class="ds-meta__item"><dt class="t-meta"><svg class="ds-icon" viewBox="0 0 256 256" fill="none" stroke="currentColor" stroke-width="16" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="32" y="48" width="192" height="144" rx="8"></rect><line x1="160" y1="224" x2="96" y2="224"></line><line x1="32" y1="152" x2="224" y2="152"></line><line x1="128" y1="192" x2="128" y2="224"></line></svg>Plataforma</dt><dd class="t-body is-key">Web (solo escritorio)</dd></div>
<div class="ds-meta__item"><dt class="t-meta"><svg class="ds-icon" viewBox="0 0 256 256" fill="none" stroke="currentColor" stroke-width="16" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="40" y1="216" x2="40" y2="56"></line><path d="M40,56H208L176,104L208,152H40"></path></svg>Estado</dt><dd class="t-body is-key"><span class="ds-status" aria-hidden="true"></span>Lanzado</dd></div>
<div class="ds-meta__item ds-meta__item--wide"><dt class="t-meta"><svg class="ds-icon" viewBox="0 0 256 256" fill="none" stroke="currentColor" stroke-width="16" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="128" cy="96" r="64"></circle><path d="M32,216c19.37-33.47,54.55-56,96-56s76.63,22.53,96,56"></path></svg>Rol</dt><dd class="t-body">Product Designer, responsable del diseño</dd></div>
<div class="ds-meta__item ds-meta__item--wide"><dt class="t-meta"><svg class="ds-icon" viewBox="0 0 256 256" fill="none" stroke="currentColor" stroke-width="16" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="84" cy="108" r="52"></circle><path d="M10.23,200a88,88,0,0,1,147.54,0"></path><path d="M172,160a87.89,87.89,0,0,1,73.77,40"></path><path d="M152.69,59.7A52,52,0,1,1,172,160"></path></svg>Equipo</dt><dd class="t-body">Responsable de ciberseguridad (impulsor del producto), apoyo puntual de diseño junior y feedback del equipo de diseño</dd></div>
</dl>
</div>
<figure class="ds-figure ds-cover">
<Imagen src={portada} alt="eSBARD Edu en un portátil, mostrando el panel de laboratorios activos" loading="eager" grande />
</figure>
</section>

<section class="ds-wrap ds-case-section" aria-labelledby="resumen">
<div class="ds-summary">
<h2 id="resumen" class="ds-summary__title ds-section-title t-section-title-mobile">Resumen</h2>
<dl class="ds-summary__list">
<div class="ds-summary__row"><dt class="t-body-strong">Problema</dt><dd class="t-body">Practicar ciberseguridad de forma realista y segura era difícil para los centros de formación, según detectó el responsable de ciberseguridad hablando con profesorado.</dd></div>
<div class="ds-summary__row"><dt class="t-body-strong">Mi papel</dt><dd class="t-body">Diseñar la plataforma, desde los wireframes técnicos del responsable de ciberseguridad hasta las pantallas finales y su design system.</dd></div>
<div class="ds-summary__row"><dt class="t-body-strong">Solución</dt><dd class="t-body">Una plataforma en la nube donde el formador prepara laboratorios, retos y ejercicios de ataque y defensa en un mismo entorno, para su alumnado.</dd></div>
<div class="ds-summary__row"><dt class="t-body-strong">Resultado</dt><dd class="t-body">El producto está en funcionamiento y el profesorado que vio el prototipo lo valoró muy positivamente.</dd></div>
</dl>
</div>
</section>

<section class="ds-wrap ds-case-section" aria-labelledby="contexto">
<h2 id="contexto" class="ds-section-title t-section-title-mobile">Contexto</h2>
<div class="ds-prose">
<p>eSBARD Edu es un producto propio de la consultora. Nació de una necesidad que el responsable de ciberseguridad detectó hablando con profesorado de universidad y formación profesional (FP): no disponían de una forma sencilla de que su alumnado practicara ataques y defensas reales en un entorno seguro.</p>
<p>La plataforma es una herramienta para el formador: le permite preparar tareas o exámenes de ataque y defensa para su alumnado. Con ella crea laboratorios virtuales en los que el alumnado ataca (Red Team, el equipo atacante) y defiende (Blue Team, el defensor), prepara retos tipo CTF (<em>capture the flag</em>, competiciones de resolución de retos) y supervisa lo que hace cada alumno. El alumnado trabaja dentro de esos laboratorios, por lo que la interfaz que diseñamos es el panel del formador.</p>
</div>
</section>

<section class="ds-wrap ds-case-section" aria-labelledby="reto">
<h2 id="reto" class="ds-section-title t-section-title-mobile">El reto</h2>
<div class="ds-prose">
<p>El punto de partida eran unos wireframes de baja fidelidad, pero muy densos en información técnica, hechos por el responsable de ciberseguridad, una persona con un conocimiento técnico muy avanzado. Buena parte de la complejidad del producto estaba en su cabeza.</p>
<p>Nuestro reto era doble:</p>
<ul>
<li>Entender un dominio muy técnico lo bastante bien como para poder simplificarlo.</li>
<li>Hacerlo usable para el mayor número de personas posible. Los usuarios son perfiles técnicos, pero el nivel de complejidad era muy alto.</li>
</ul>
<p>Además, el diseño debía mantener continuidad con eSBARD, la versión profesional del producto: una plataforma basada en Grafana, sin publicar, de la que solo existían en Figma el logo y una paleta básica de colores.</p>
</div>
</section>

<section class="ds-wrap ds-case-section" aria-labelledby="momentos">
<h2 id="momentos" class="ds-section-title t-section-title-mobile">Momentos clave</h2>
<ol class="ds-steps">

<li class="ds-step">
<div class="ds-prose">
<h3 class="ds-step__head"><span class="ds-step__num t-meta">1</span><span class="ds-step__title t-subhead">Traducir antes de diseñar</span></h3>
<p>No hubo investigación con usuarios al uso: nuestra investigación fue entender al experto. Trabajamos muy de cerca con el responsable de ciberseguridad, revisando con él cada flujo y cada pantalla de sus wireframes hasta entender qué hacía cada herramienta, para quién y en qué momento. Sin esa fase, cualquier simplificación habría sido superficial.</p>
</div>
<figure class="ds-figure ds-figure--text">
<Imagen src={mapaWireframes} alt="Mapa completo de los wireframes originales: decenas de pantallas conectadas con flechas y anotaciones técnicas" loading="lazy" grande />
<figcaption class="t-meta">Mapa original de wireframes: decenas de pantallas, flujos y anotaciones técnicas</figcaption>
</figure>
</li>

<li class="ds-step">
<div class="ds-prose">
<h3 class="ds-step__head"><span class="ds-step__num t-meta">2</span><span class="ds-step__title t-subhead">Simplificar sin quitar potencia</span></h3>
<p>Reorganizamos la información para que fuera fácil encontrar las herramientas y entender los flujos del panel del formador. La herramienta sigue siendo compleja (requiere una formación previa), pero el objetivo era que la complejidad estuviera en los ejercicios, no en la interfaz.</p>
<p>Un ejemplo es la asignación de usuarios a los equipos. En el wireframe original, una sola tabla mezclaba los datos técnicos (grupo de WireGuard, imagen de máquina virtual, dos direcciones IP) con la lista de usuarios de Red Team y Blue Team. Propusimos que crear un laboratorio fuera un asistente por pasos (General, Usuarios, Scripts y Resumen). La separación por equipos ya venía de los wireframes del responsable de ciberseguridad; en la pantalla final, cada equipo es un bloque con su lista, su IP de VPN y acciones para asignar o eliminar.</p>
</div>
<div class="ds-pair">
<figure class="ds-figure">
<Imagen src={wireframeUsuarios} alt="Wireframe original de la pantalla de usuarios de Blue Team y Red Team, con campos técnicos y anotaciones" loading="lazy" grande />
<figcaption class="t-meta">Antes: wireframe original</figcaption>
</figure>
<figure class="ds-figure">
<Imagen src={pantallaUsuarios} alt="Pantalla final de asignación de usuarios a Blue Team y Red Team" loading="lazy" grande />
<figcaption class="t-meta">Después: pantalla final</figcaption>
</figure>
</div>
</li>

<li class="ds-step">
<div class="ds-prose">
<h3 class="ds-step__head"><span class="ds-step__num t-meta">3</span><span class="ds-step__title t-subhead">Construir sobre un sistema, pensando en el futuro</span></h3>
<p>Partimos del UI Kit de Saga, el sistema de diseño de Grafana publicado en Figma, para crear el design system de eSBARD Edu. Como eSBARD está basado en Grafana y no tenía nada en Figma, adaptar un sistema ya existente daba continuidad visual con la plataforma y una base sólida. Así, eSBARD y eSBARD Edu podrían crecer de forma coherente.</p>
</div>
<div class="ds-pair">
<figure class="ds-figure">
<button type="button" class="ds-zoom" data-ampliar="A" aria-label="Ampliar imagen: Fundamentos: color y tipografía"><Imagen src={dsFundamentos} alt="Fundamentos del design system de eSBARD Edu en modo oscuro: paleta de fondos, texto, acento lila-azulado y estados, y escala tipográfica en BBC Reith Sans" loading="lazy" grande /></button>
<figcaption class="t-meta">Fundamentos: color y tipografía</figcaption>
</figure>
<figure class="ds-figure">
<button type="button" class="ds-zoom" data-ampliar="B" aria-label="Ampliar imagen: Componentes y composición"><Imagen src={dsComponentes} alt="Componentes del design system de eSBARD Edu: botones, campos de texto, selectores, pestañas, tablas, etiquetas de estado y tarjetas de laboratorio, con ejemplos de composición" loading="lazy" grande /></button>
<figcaption class="t-meta">Componentes y composición</figcaption>
</figure>
</div>
<p class="ds-step__note t-meta">Design system de eSBARD Edu, adaptado del UI Kit de Saga (Grafana)</p>
</li>

<li class="ds-step">
<div class="ds-prose">
<h3 class="ds-step__head"><span class="ds-step__num t-meta">4</span><span class="ds-step__title t-subhead">Accesibilidad de la identidad visual</span></h3>
<p>De eSBARD solo existían el logo y una paleta básica de colores, con problemas de accesibilidad. Propusimos ajustar la paleta y la tipografía, y las propuestas se aceptaron. Comprobamos el contraste con Stark. El texto principal, un gris claro (#CCCCDC) sobre las superficies de la interfaz (#22262B), alcanza una ratio de 9,57:1 y cumple el nivel AAA, el más exigente de las pautas de accesibilidad WCAG. El morado de acento (#7264E5) sobre el fondo oscuro (#181B1F) llega a 3,84:1, que cumple el nivel AA para elementos gráficos y de interfaz, como botones e iconos. Elegimos BBC Reith Sans tras investigar tipografías accesibles: la BBC la creó junto con Dalton Maag para mejorar la legibilidad en pantalla y la accesibilidad.</p>
</div>
<div class="ds-pair ds-pair--side">
<figure class="ds-figure">
<Imagen src={contrasteTexto} alt="Comprobación de contraste en Stark: texto gris claro #CCCCDC sobre fondo #22262B, ratio 9,57:1, que cumple AA y AAA para texto normal y grande" loading="lazy" tamano="pequena" grande />
<figcaption class="t-meta">Texto principal: 9,57:1, nivel AAA</figcaption>
</figure>
<figure class="ds-figure">
<Imagen src={contrasteAcento} alt="Comprobación de contraste en Stark: morado #7264E5 sobre fondo #181B1F, ratio 3,84:1, que cumple el nivel AA para elementos gráficos y de interfaz" loading="lazy" tamano="pequena" grande />
<figcaption class="t-meta">Acento de interfaz: 3,84:1, nivel AA para elementos gráficos</figcaption>
</figure>
</div>
</li>

</ol>
</section>

<section class="ds-wrap ds-case-section" aria-labelledby="solucion">
<div class="ds-block">
<h2 id="solucion" class="ds-section-title t-section-title-mobile">La solución</h2>
<div class="ds-prose">
<p>Las pantallas que se muestran en la web de presentación del producto las diseñé yo. Las capturas usan datos de demostración.</p>
</div>
</div>
<figure class="ds-figure ds-cover">
<Imagen src={portatilUsuarios} alt="eSBARD Edu en un portátil, mostrando la asignación de usuarios a Blue Team y Red Team" loading="lazy" grande />
</figure>
<figure class="ds-figure">
<Imagen src={pantallaUsuarios} alt="Pantalla de asignación de usuarios a Blue Team y Red Team, con su IP de VPN" loading="lazy" grande />
<figcaption class="t-meta">Red y Blue Team integrados: asignación de usuarios por equipo</figcaption>
</figure>
<figure class="ds-figure">
<Imagen src={laboratorios} alt="Listado de laboratorios activos en tarjetas, cada uno con su estado: en marcha, pausado, listo u ocupado" loading="lazy" grande />
<figcaption class="t-meta">Laboratorios activos y su estado</figcaption>
</figure>
<figure class="ds-figure">
<Imagen src={retosCtf} alt="Asistente para crear un laboratorio: selección de grupos y retos CTF con sus bloqueos" loading="lazy" grande />
<figcaption class="t-meta">Retos CTF personalizables por grupo</figcaption>
</figure>
<figure class="ds-figure">
<Imagen src={plantillas} alt="Listado de plantillas de escenarios con su tipo, descripción y autor" loading="lazy" grande />
<figcaption class="t-meta">Plantillas reutilizables y editables</figcaption>
</figure>
</section>

<section class="ds-wrap ds-case-section" aria-labelledby="validacion">
<h2 id="validacion" class="ds-section-title t-section-title-mobile">Validación y resultados</h2>
<div class="ds-prose">
<ul>
<li><strong>Con el profesorado:</strong> mostramos el prototipo a profesorado universitario. La valoración fue muy positiva: veían la plataforma como una herramienta realmente útil y entendían bien cómo estaba planteada.</li>
<li><strong>En el equipo:</strong> el feedback de compañeros de la consultora sobre el diseño visual fue muy bueno.</li>
<li><strong>Hoy:</strong> la plataforma está en funcionamiento y se comercializa para centros educativos y empresas.</li>
</ul>
<p>No pudimos hacer tests de usabilidad con usuarios finales. Tras entregar el diseño al equipo de desarrollo, salí del proyecto y no tengo datos de uso.</p>
</div>
</section>

<section class="ds-wrap ds-case-section" aria-labelledby="aprendizajes">
<h2 id="aprendizajes" class="ds-section-title t-section-title-mobile">Aprendizajes</h2>
<div class="ds-prose">
<ul>
<li>En productos técnicos, buena parte de diseñar es traducir. Nuestra aportación más valiosa no fueron las pantallas, sino entender lo suficiente para convertir la complejidad en algo usable.</li>
<li>Pensar en sistema desde el principio facilita que un producto con varias versiones crezca de forma coherente.</li>
<li>Lo que haríamos diferente: incluir tests de usabilidad con formadores antes de cerrar el diseño, y pedir acceso a datos de uso para seguir iterando.</li>
</ul>
</div>
</section>

<section class="ds-wrap ds-case-section" aria-labelledby="mas">
<h2 id="mas" class="ds-section-title t-section-title-mobile">Más proyectos</h2>
<ListaProyectos actual="/trabajo/esbard-edu/" />
</section>

</main>

<dialog class="ds-lightbox" id="ampliada" aria-label="Imagen ampliada">
<button type="button" class="ds-lightbox__close" aria-label="Cerrar imagen ampliada"><svg viewBox="0 0 256 256" width="24" height="24" fill="none" stroke="currentColor" stroke-width="16" stroke-linecap="round" aria-hidden="true"><line x1="200" y1="56" x2="56" y2="200"></line><line x1="200" y1="200" x2="56" y2="56"></line></svg></button>
<img src="" alt="">
</dialog>
<script>
// Ampliar imagen: cada botón «ds-zoom» abre la imagen que contiene en un <dialog>.
// El navegador se encarga de atrapar el foco, cerrar con Esc y devolver el foco al botón.
const dialogo = document.getElementById('ampliada');
const grande = dialogo.querySelector('img');
document.querySelectorAll('.ds-zoom').forEach((boton) => {
  boton.addEventListener('click', () => {
    const origen = boton.querySelector('img');
    grande.src = origen.dataset.grande || origen.currentSrc || origen.src;
    grande.alt = origen.alt;
    dialogo.setAttribute('aria-label', 'Imagen ampliada: ' + boton.getAttribute('aria-label').replace('Ampliar imagen: ', ''));
    dialogo.showModal();
    dialogo.querySelector('.ds-lightbox__close').focus();
  });
});
dialogo.addEventListener('click', (e) => { if (e.target !== grande) dialogo.close(); });
</script>
</Base>
