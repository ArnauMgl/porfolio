---
import Imagen from '../../components/Imagen.astro';
// Caso de estudio: Planificador de medicación imprimible. Marcado del artboard «CasePlanificadorMobile» (diseno/CasePlanificadorMobile.dc.html), con rutas reales.
// La portada se ve en la primera pantalla y no se difiere; el resto de imágenes se cargan al acercarse.
import Base from '../../layouts/Base.astro';
import ListaProyectos from '../../components/ListaProyectos.astro';
import portada from '../../assets/proyectos/planificador-medicacion.webp';
import nevera from '../../assets/planificador-medicacion/nevera.webp';
import plantillasInternet from '../../assets/planificador-medicacion/plantillas-internet.webp';
import cajaPosologia from '../../assets/planificador-medicacion/caja-posologia.webp';
import cajaMomentos from '../../assets/planificador-medicacion/caja-momentos.webp';
import primeraVersion from '../../assets/planificador-medicacion/primera-version.webp';
import momentosDelDia from '../../assets/planificador-medicacion/momentos-del-dia.webp';
import leyendaIconos from '../../assets/planificador-medicacion/leyenda-iconos.webp';
import alternativaHoja1 from '../../assets/planificador-medicacion/alternativa-hoja-1.webp';
import alternativaHoja2 from '../../assets/planificador-medicacion/alternativa-hoja-2.webp';
import pagina1 from '../../assets/planificador-medicacion/pagina-1.webp';
import pagina2 from '../../assets/planificador-medicacion/pagina-2.webp';
---
<Base
  imagen="/og/og-planificador-medicacion.jpg"
  imagenAlt="Caso de estudio: Planificador de medicación imprimible, por Arnau Larripa"
  title="Planificador de medicación imprimible · Arnau Larripa"
  description="Caso de estudio: cómo diseñamos un planificador de medicación en PDF para que las personas mayores y sus cuidadores tengan su tratamiento siempre a la vista, en papel."
  actual="caso"
>
<main id="caso">

<section class="ds-wrap ds-case-head" aria-labelledby="caso-titulo">
<div class="ds-prose">
<h1 id="caso-titulo" class="ds-case__title t-page-title-mobile">Planificador de medicación imprimible</h1>
<p class="ds-case__subtitle t-statement">Del papelito de la nevera a un plan claro para cada día</p>
<p class="t-body">Diseñamos un planificador de medicación en PDF, pensado para generarse desde una app de salud pública, para que las personas mayores y sus cuidadores pudieran tener su tratamiento siempre a la vista, en papel.</p>
<dl class="ds-meta">
<div class="ds-meta__item"><dt class="t-meta"><svg class="ds-icon" viewBox="0 0 256 256" fill="none" stroke="currentColor" stroke-width="16" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="128" cy="128" r="96"></circle><polyline points="128 72 128 128 184 128"></polyline></svg>Duración</dt><dd class="t-body is-key">Unos 2 meses (mes y medio de dedicación completa)</dd></div>
<div class="ds-meta__item"><dt class="t-meta"><svg class="ds-icon" viewBox="0 0 256 256" fill="none" stroke="currentColor" stroke-width="16" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="48" y="48" width="64" height="64" rx="8"></rect><rect x="144" y="48" width="64" height="64" rx="8"></rect><rect x="48" y="144" width="64" height="64" rx="8"></rect><rect x="144" y="144" width="64" height="64" rx="8"></rect></svg>Sector</dt><dd class="t-body is-key">Salud pública</dd></div>
<div class="ds-meta__item"><dt class="t-meta"><svg class="ds-icon" viewBox="0 0 256 256" fill="none" stroke="currentColor" stroke-width="16" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="32" y="48" width="192" height="144" rx="8"></rect><line x1="160" y1="224" x2="96" y2="224"></line><line x1="32" y1="152" x2="224" y2="152"></line><line x1="128" y1="192" x2="128" y2="224"></line></svg>Plataforma</dt><dd class="t-body is-key">PDF imprimible, pensado para generarse desde la app</dd></div>
<div class="ds-meta__item"><dt class="t-meta"><svg class="ds-icon" viewBox="0 0 256 256" fill="none" stroke="currentColor" stroke-width="16" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="40" y1="216" x2="40" y2="56"></line><path d="M40,56H208L176,104L208,152H40"></path></svg>Estado</dt><dd class="t-body is-key"><span class="ds-status ds-status--hollow" aria-hidden="true"></span>Propuesta · No implementada</dd></div>
<div class="ds-meta__item ds-meta__item--wide"><dt class="t-meta"><svg class="ds-icon" viewBox="0 0 256 256" fill="none" stroke="currentColor" stroke-width="16" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="128" cy="96" r="64"></circle><path d="M32,216c19.37-33.47,54.55-56,96-56s76.63,22.53,96,56"></path></svg>Rol</dt><dd class="t-body">Product Designer principal, con supervisión de Lead de diseño y Product Owner</dd></div>
<div class="ds-meta__item ds-meta__item--wide"><dt class="t-meta"><svg class="ds-icon" viewBox="0 0 256 256" fill="none" stroke="currentColor" stroke-width="16" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="84" cy="108" r="52"></circle><path d="M10.23,200a88,88,0,0,1,147.54,0"></path><path d="M172,160a87.89,87.89,0,0,1,73.77,40"></path><path d="M152.69,59.7A52,52,0,1,1,172,160"></path></svg>Equipo</dt><dd class="t-body">Diseño en la fase inicial, Lead de diseño y Product Owner</dd></div>
</dl>
</div>
<figure class="ds-figure ds-cover">
<Imagen src={portada} alt="Hoja del planificador, en catalán, vista en perspectiva: tabla de medicamentos con los cuatro momentos del día y, bajo cada medicamento, una tira con los días del mes" loading="eager" />
<figcaption class="t-meta">Planificador mensual en formato horizontal, con datos de ejemplo</figcaption>
</figure>
</section>

<section class="ds-wrap ds-case-section" aria-labelledby="resumen">
<div class="ds-summary">
<h2 id="resumen" class="ds-summary__title ds-section-title t-section-title-mobile">Resumen</h2>
<dl class="ds-summary__list">
<div class="ds-summary__row"><dt class="t-body-strong">Problema</dt><dd class="t-body">Muchas personas mayores organizan su medicación con notas hechas a mano. Es fácil equivocarse, y más cuando se toman varios medicamentos.</dd></div>
<div class="ds-summary__row"><dt class="t-body-strong">Mi papel</dt><dd class="t-body">Diseñar el planificador, partiendo de lo aprendido en las entrevistas de otro proyecto de medicación.</dd></div>
<div class="ds-summary__row"><dt class="t-body-strong">Solución</dt><dd class="t-body">Un PDF en blanco y negro, en A4 apaisado, con una fila por medicamento pensada para mostrar de un vistazo cuánto tomar en cada momento del día y en qué días del mes, con iconos para la forma de tomarlo y los avisos importantes.</dd></div>
<div class="ds-summary__row"><dt class="t-body-strong">Resultado</dt><dd class="t-body">Un planificador que muestra la medicación, su posología, los efectos adversos y otras indicaciones en un documento imprimible.</dd></div>
</dl>
</div>
</section>

<section class="ds-wrap ds-case-section" aria-labelledby="contexto">
<h2 id="contexto" class="ds-section-title t-section-title-mobile">Contexto</h2>
<div class="ds-prose">
<p>La app permite a la ciudadanía consultar su medicación, pero buena parte de las personas mayores sigue confiando en el papel. En las entrevistas de otro proyecto de medicación, con pacientes y cuidadores, apareció una y otra vez la misma expresión: «el papelito de la nevera». Varias de las personas entrevistadas se hacían su propio esquema a mano y lo colgaba en la nevera para no olvidar ninguna toma.</p>
<p>De ahí nació la idea de partir de ese papel para facilitar la toma de la medicación, también cuando es compleja, y mejorar así la adherencia al tratamiento. Un planificador que se generaría automáticamente en la sección de medicación de la app, listo para imprimir.</p>
</div>
</section>

<section class="ds-wrap ds-case-section" aria-labelledby="reto">
<h2 id="reto" class="ds-section-title t-section-title-mobile">El reto</h2>
<div class="ds-prose">
<p>Diseñar un documento que cualquier persona entendiera sin explicaciones, con condiciones muy concretas:</p>
<ul>
<li>Que fuera accesible: blanco y negro, porque se imprime en casa, con alto contraste y el texto principal en Arial a 12 puntos.</li>
<li>Vista mensual, con espacio para anotaciones.</li>
<li>Una sola página hasta cuatro medicamentos, para poder colgarla en la nevera.</li>
<li>Que fuera escalable, para personas con muchos medicamentos y tomas distintas.</li>
</ul>
<p>El objetivo de fondo era la adherencia al tratamiento: que la gente tome su medicación como le corresponde.</p>
</div>
</section>

<section class="ds-wrap ds-case-section" aria-labelledby="momentos">
<h2 id="momentos" class="ds-section-title t-section-title-mobile">Momentos clave</h2>
<ol class="ds-steps">

<li class="ds-step">
<div class="ds-prose">
<h3 class="ds-step__head"><span class="ds-step__num t-meta">01</span><span class="ds-step__title t-subhead">Escuchar cómo se organiza la gente de verdad</span></h3>
<p>En otro proyecto de medicación entrevistamos a pacientes y a cuidadores para entender cómo gestionaban su medicación. En paralelo, mantuve conversaciones informales con profesionales de enfermería y farmacia para entender el lado clínico. Uno de los hallazgos más interesantes fue el papelito de la nevera: la solución tenía que parecerse a lo que la gente ya hacía, no a una app.</p>
</div>
<figure class="ds-figure ds-figure--text">
<Imagen src={nevera} alt="Esquema hecho a mano y pegado en una nevera, en catalán: tabla con desayuno, comida y cena; tres medicamentos con su dosis, un apunte resaltado sobre cómo tomar uno de ellos y otro medicamento tachado" loading="lazy" />
<figcaption class="t-meta">Esquema hecho a mano en una nevera</figcaption>
</figure>
<div class="ds-prose">
<p>También miramos cómo se organiza hoy la medicación en objetos cotidianos: pastilleros semanales, plantillas imprimibles que se encuentran en internet y las propias cajas de los medicamentos. Las plantillas organizan el día por momentos o por comidas, casi siempre con tablas en blanco que hay que rellenar a mano. Las cajas ya incluyen un espacio para anotar la posología y, en algunas, iconos con los momentos del día en que tomarla. Y el pastillero que miramos divide el día en mañana, tarde y noche, en lugar de en horas. Dos de esas ideas están en el planificador: una columna de anotaciones y los momentos del día.</p>
</div>
<figure class="ds-figure ds-figure--text">
<Imagen src={plantillasInternet} alt="Montaje de cuatro plantillas de medicación: una tabla con filas de mañana, mediodía, tarde, noche y solo cuando lo necesito; un planificador de un día con columnas de mañana, mediodía y noche; un plan de medicación organizado por comidas; y una hoja de pauta con campos para dosis, horario y motivo" loading="lazy" />
<figcaption class="t-meta">Plantillas de medicación que se encuentran en internet. Fuentes: EDIT.org, PLANSMART, Cruz Roja (SerCuidador) y PCNA</figcaption>
</figure>
<div class="ds-pair ds-pair--side">
<figure class="ds-figure">
<Imagen src={cajaPosologia} alt="Detalle de una caja de medicamento con un recuadro en blanco rotulado «Posología», para anotar la pauta a mano" loading="lazy" tamano="pequena" />
<figcaption class="t-meta">Una caja con un recuadro en blanco para anotar la posología</figcaption>
</figure>
<figure class="ds-figure">
<Imagen src={cajaMomentos} alt="Detalle de otra caja de medicamento con tres iconos (amanecer, mediodía y noche) y líneas de puntos para anotar la dosis de cada momento" loading="lazy" tamano="pequena" />
<figcaption class="t-meta">Otra caja con los momentos del día y líneas para anotar la dosis</figcaption>
</figure>
</div>
</li>

<li class="ds-step">
<div class="ds-prose">
<h3 class="ds-step__head"><span class="ds-step__num t-meta">02</span><span class="ds-step__title t-subhead">Las restricciones como punto de partida</span></h3>
<p>El blanco y negro, el A4 y la accesibilidad no eran limitaciones, eran el diseño. El texto principal va en negro sobre blanco y en Arial a 12 puntos. Cada elemento tenía que ganarse su espacio en la hoja.</p>
</div>
<figure class="ds-figure ds-figure--text">
<Imagen class="ds-sheet" src={primeraVersion} alt="Primera versión del documento, en catalán: tabla en blanco y negro con medicamento, vigencia, administración, comentarios y anotaciones, y las tomas ligadas a desayuno, comida y cena" loading="lazy" />
<figcaption class="t-meta">Primera versión: tabla por columnas, en blanco y negro y A4 apaisado</figcaption>
</figure>
</li>

<li class="ds-step">
<div class="ds-prose">
<h3 class="ds-step__head"><span class="ds-step__num t-meta">03</span><span class="ds-step__title t-subhead">Entender el día de un vistazo</span></h3>
<p>Cada medicamento ocupa una fila horizontal con todo lo que hay que saber: nombre, tipo y vía de administración, cuánto tomar, cómo tomarlo, duración del tratamiento y un espacio para anotaciones.</p>
<p>La primera versión situaba las tomas en torno a las comidas. En la propuesta final no usamos horas exactas, porque no se sabe a qué hora toma realmente cada persona su medicación: el día se divide en cuatro momentos (mañana, mediodía, tarde y noche), cada uno con su icono y su cantidad. Otro icono indica cómo tomarlo (con alimentos, en ayunas, antes o después de la comida) y otros avisan de efectos adversos, como la somnolencia o la fatiga. Todos llevan su leyenda escrita, para no depender solo del dibujo.</p>
<p>Debajo de cada fila, una tira con los días del mes marca en cuáles toca tomarlo; los días sin toma se muestran en gris claro, como deshabilitados. Sirve sobre todo para pautas poco habituales, como un parche que se cambia cada tres días.</p>
</div>
<div class="ds-pair">
<figure class="ds-figure">
<Imagen src={momentosDelDia} alt="Cabecera de la tabla con las columnas de mañana, mediodía, tarde y noche, y la fila de un parche con una toma por la mañana y una tira de 31 días con los días de toma resaltados cada tres días" loading="lazy" />
<figcaption class="t-meta">Los cuatro momentos del día y la tira de días de toma de un medicamento</figcaption>
</figure>
<figure class="ds-figure">
<Imagen src={leyendaIconos} alt="Leyenda de iconos, en catalán: efectos adversos (somnolencia, malestar estomacal, fatiga y cambios de ánimo), forma de tomar (con alimentos, en ayunas, antes y después de la comida) y días con y sin toma" loading="lazy" />
<figcaption class="t-meta">Leyenda: efectos adversos, forma de tomar y días de toma</figcaption>
</figure>
</div>
</li>

<li class="ds-step">
<div class="ds-prose">
<h3 class="ds-step__head"><span class="ds-step__num t-meta">04</span><span class="ds-step__title t-subhead">Muchos medicamentos, varias formas de organizarlos</span></h3>
<p>Exploramos varios enfoques. Uno repartía la información en dos hojas: una tabla de medicamentos y un calendario del mes con un círculo numerado por cada medicamento del listado, repetido en cada día. El que defendimos junta en una fila toda la pauta de cada medicamento, en formato horizontal. Funcionaba mejor porque cada medicamento lleva mucha información, y el formato apaisado permite mostrarla sin comprimirla.</p>
<p>No era posible que cupiera todo en una hoja: a partir de cuatro o cinco medicamentos hacía falta más de una. Por eso el diseño se pensó para extenderse a varias páginas, con el encabezado de la tabla repetido y las páginas numeradas.</p>
</div>
<figure class="ds-figure ds-figure--text">
<Imagen class="ds-sheet" src={alternativaHoja1} alt="Primera hoja de la alternativa de varias páginas, en catalán: tabla con tres medicamentos numerados, sus dosis, los cuatro momentos del día, iconos de alertas y la leyenda al pie" loading="lazy" />
<figcaption class="t-meta">Alternativa de varias páginas, hoja 1: tabla con los medicamentos numerados</figcaption>
</figure>
<figure class="ds-figure ds-figure--text">
<Imagen class="ds-sheet" src={alternativaHoja2} alt="Segunda hoja de la alternativa de varias páginas, en catalán: calendario de agosto con quince círculos numerados en cada día, uno por medicamento" loading="lazy" />
<figcaption class="t-meta">Alternativa de varias páginas, hoja 2: calendario del mes con un círculo por medicamento</figcaption>
</figure>
</li>

</ol>
</section>

<section class="ds-wrap ds-case-section" aria-labelledby="solucion">
<div class="ds-block">
<h2 id="solucion" class="ds-section-title t-section-title-mobile">La solución</h2>
<div class="ds-prose">
<p>El planificador final es una hoja A4 apaisada que se extiende a las páginas necesarias según el número de medicamentos. Con todos los requisitos, no había forma de que todo cupiera en una sola página, porque hay personas polimedicadas con más de 12 medicamentos.</p>
</div>
<figure class="ds-figure">
<Imagen class="ds-sheet" src={pagina1} alt="Primera página del planificador, en catalán: título con el nombre del paciente y el mes, aviso de reimpresión, leyenda de iconos y tres medicamentos con su dosis, vía, cantidad en cada momento del día, forma de tomarlo, duración, anotaciones y tira de días de toma" loading="lazy" />
<figcaption class="t-meta">Página 1 de 2 del planificador mensual en formato horizontal, con datos ficticios</figcaption>
</figure>
<figure class="ds-figure">
<Imagen class="ds-sheet" src={pagina2} alt="Tabla de la segunda página del planificador, en catalán: encabezado repetido y cuatro medicamentos con su dosis, vía, momentos del día y duración, cada uno con una tira de 31 días con distintos patrones de días de toma" loading="lazy" />
<figcaption class="t-meta">Página 2 de 2 (tabla): continúa con el mismo encabezado, con datos ficticios</figcaption>
</figure>
</div>
</section>

<section class="ds-wrap ds-case-section" aria-labelledby="validacion">
<h2 id="validacion" class="ds-section-title t-section-title-mobile">Validación y resultados</h2>
<div class="ds-prose">
<ul>
<li>El diseño se basó en lo que aprendimos en las entrevistas con pacientes y cuidadores de otro proyecto de medicación.</li>
<li>Los requisitos cambiaron por el camino. Al compartirse con más responsables del ámbito sanitario, el proyecto creció en alcance y la restricción de una sola página pasó a ser «las hojas necesarias», también para personas polimedicadas. Por motivos de gestión tuve que centrarme en otro proyecto y el planificador siguió por otro camino.</li>
<li>La propuesta que defendimos, la de formato horizontal, no llegó a implementarse ni a probarse impresa con usuarios, y no se diseñó la pantalla de la app desde la que se genera el PDF.</li>
<li>Creemos que llegamos a una muy buena solución, pero por motivos ajenos al diseño el proyecto no siguió como teníamos previsto.</li>
</ul>
</div>
</section>

<section class="ds-wrap ds-case-section" aria-labelledby="aprendizajes">
<h2 id="aprendizajes" class="ds-section-title t-section-title-mobile">Aprendizajes</h2>
<div class="ds-prose">
<ul>
<li>Simplificar no siempre es quitar información: a menudo es elegir cómo mostrarla. Dividir el día en cuatro momentos, en lugar de horas exactas, buscaba que la hoja fuera más fácil de leer sin recortar información.</li>
<li>Diseñar para papel obliga a priorizar como pocas cosas: no hay scroll, ni interacción, ni color.</li>
<li>Lo que haríamos diferente: probar versiones impresas con pacientes y cuidadores desde el principio, aunque fuera de forma sencilla, para defender las decisiones con evidencia cuando cambiaron los requisitos.</li>
</ul>
</div>
</section>

<section class="ds-wrap ds-case-section" aria-labelledby="mas">
<h2 id="mas" class="ds-section-title t-section-title-mobile">Más proyectos</h2>
<ListaProyectos actual="/trabajo/planificador-medicacion/" />
</section>

</main>
</Base>
