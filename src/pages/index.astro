---
// Home. Marcado del artboard «Mobile» (diseno/Mobile.dc.html), con enlaces a rutas reales.
import Base from '../layouts/Base.astro';
import ListaProyectos from '../components/ListaProyectos.astro';

const citas = [
  { texto: '«Su capacidad para combinar creatividad con un enfoque estratégico lo convierte en un diseñador muy completo. Siempre destacó por su compromiso, conocimientos, atención al detalle y habilidad para colaborar en equipo.»', nombre: 'Joan Bagan', cargo: 'Senior Product Designer / Design Team Lead' },
  { texto: '«Lo que más destaco de él es su responsabilidad y su constante búsqueda por mejorar, crecer y seguir aprendiendo. Su actitud proactiva y sus ganas de superarse hacen que sea un profesional que suma muchísimo a cualquier proyecto.»', nombre: 'Tamara Chertkoff', cargo: 'UX/UI Designer' },
];
---
<Base
  title="Arnau Larripa · Product Designer en Barcelona"
  description="Product Designer en Barcelona. Diseño productos digitales pensados para el día a día, de la investigación con usuarios al diseño final."
  actual="inicio"
>
<main id="inicio">
<section class="ds-wrap ds-hero" aria-labelledby="titular">
<h1 id="titular" class="ds-hero__title t-hero-mobile">Arnau Larripa<br>Product Designer<span class="ds-dot">.</span></h1>
<div class="ds-intro">
<p class="ds-intro__text t-statement">Diseño productos digitales pensados para el día a día.</p>
<a class="ds-btn t-button" href="mailto:hola@arnaularripa.com">Contacto</a>
</div>
</section>

<section id="trabajo" class="ds-wrap ds-section" aria-labelledby="trabajo-titulo">
<div class="ds-section__head"><h2 id="trabajo-titulo" class="ds-section-title ds-section-title--grande t-section-title-mobile">Trabajo seleccionado</h2></div>
<ListaProyectos indice />
<p class="ds-work__more"><a class="ds-link ds-link--touch t-body" href="/trabajo/">Ver todo el trabajo<svg class="ds-icon" viewBox="0 0 256 256" fill="none" stroke="currentColor" stroke-width="16" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="40" y1="128" x2="216" y2="128"></line><polyline points="144 56 216 128 144 200"></polyline></svg></a></p>
</section>

<section class="ds-wrap ds-section" aria-labelledby="dicen-titulo">
<div class="ds-section__head"><h2 id="dicen-titulo" class="ds-section-title t-section-title-mobile">Lo que dicen</h2></div>
<ul class="ds-quotes">
{citas.map((c) => (
<li>
<figure class="ds-quote">
<blockquote class="ds-quote__text t-quote"><p>{c.texto}</p></blockquote>
<figcaption class="ds-quote__by"><span class="ds-quote__name t-body-strong">{c.nombre}</span><span class="ds-quote__role t-meta">{c.cargo}</span></figcaption>
</figure>
</li>
))}
</ul>
<p class="ds-quotes__more"><a class="ds-link ds-link--touch t-body" href="https://www.linkedin.com/in/arnaumiguel/" target="_blank" rel="noopener" aria-label="Ver recomendaciones en LinkedIn (se abre en una pestaña nueva)">Ver recomendaciones en LinkedIn<svg class="ds-icon" viewBox="0 0 256 256" fill="none" stroke="currentColor" stroke-width="16" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="64" y1="192" x2="192" y2="64"></line><polyline points="88 64 192 64 192 168"></polyline></svg></a></p>
</section>
</main>
</Base>
