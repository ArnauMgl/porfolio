---
// Plantilla base de todas las páginas: <head>, cabecera, contenido y pie.
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Contacto from '../components/Contacto.astro';
import '../styles/fuentes.css';
import '../styles/tokens.css';
import '../styles/components.css';
import '../styles/wip.css';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  actual?: 'inicio' | 'trabajo' | 'caso' | 'sobre-mi';
  // Imagen para compartir en redes (1200×630, en public/og/). Por defecto, la general.
  imagen?: string;
  imagenAlt?: string;
  // Página que no debe indexarse (por ejemplo, la 404): añade robots noindex y omite canonical y og:url.
  noindex?: boolean;
  // Blog WIP: tema amarillo y tinta negra (src/styles/wip.css), enlace al feed RSS y tipo «article» para redes.
  tema?: 'wip';
  // Solo artículos: fecha de publicación (AAAA-MM-DD) para article:published_time.
  publicadoEn?: string;
  // El email del pie abre el panel de contacto (#contacto) en vez de un mailto:.
  emailContacto?: boolean;
}
const { title, description, actual, imagen = '/og/og-general.png', imagenAlt = 'Arnau Larripa, Product Designer en Barcelona', noindex = false, tema, publicadoEn, emailContacto = false } = Astro.props;
const imagenUrl = new URL(imagen, Astro.site).href;
const canonica = new URL(Astro.url.pathname, Astro.site).href;
---
<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="icon" href="/favicon.ico" sizes="32x32">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="manifest" href="/site.webmanifest">
{noindex && <meta name="robots" content="noindex">}
{!noindex && <link rel="canonical" href={canonica}>}
<meta property="og:type" content={publicadoEn ? 'article' : 'website'}>
{publicadoEn && <meta property="article:published_time" content={publicadoEn}>}
{tema === 'wip' && <link rel="alternate" type="application/rss+xml" title="WIP · Arnau Larripa" href="/blog/rss.xml">}
<meta property="og:site_name" content="Arnau Larripa">
<meta property="og:locale" content="es_ES">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
{!noindex && <meta property="og:url" content={canonica}>}
<meta property="og:image" content={imagenUrl}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content={imagenAlt}>
<meta name="twitter:image" content={imagenUrl}>
<meta name="twitter:image:alt" content={imagenAlt}>
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<link rel="preload" href="/fonts/inter-tight-latin.woff2" as="font" type="font/woff2" crossorigin>
</head>
<body class={tema === 'wip' ? 'tema-wip' : undefined}>
<div class="ds-page t-body">
<Header actual={actual} />
<slot />
<Footer emailContacto={emailContacto} />
</div>
<Contacto />
<script>import '../scripts/contacto.js';</script>
</body>
</html>
