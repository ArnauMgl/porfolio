---
// Plantilla base de todas las páginas: <head>, cabecera, contenido y pie.
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Contacto from '../components/Contacto.astro';
import '../styles/fuentes.css';
import '../styles/tokens.css';
import '../styles/components.css';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  actual?: 'inicio' | 'trabajo' | 'caso' | 'sobre-mi';
  // Imagen para compartir en redes (1200×630, en public/og/). Por defecto, la general.
  imagen?: string;
  imagenAlt?: string;
  // Página que no debe indexarse (por ejemplo, la 404): añade robots noindex y omite canonical y og:url.
  noindex?: boolean;
}
const { title, description, actual, imagen = '/og/og-general.png', imagenAlt = 'Arnau Larripa, Product Designer en Barcelona', noindex = false } = Astro.props;
const imagenUrl = new URL(imagen, Astro.site).href;
const canonica = new URL(Astro.url.pathname, Astro.site).href;
---
<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="icon" href="/favicon.ico" sizes="32x32">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="manifest" href="/site.webmanifest">
{noindex && <meta name="robots" content="noindex">}
{!noindex && <link rel="canonical" href={canonica}>}
<meta property="og:type" content="website">
<meta property="og:site_name" content="Arnau Larripa">
<meta property="og:locale" content="es_ES">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
{!noindex && <meta property="og:url" content={canonica}>}
<meta property="og:image" content={imagenUrl}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content={imagenAlt}>
<meta name="twitter:image" content={imagenUrl}>
<meta name="twitter:image:alt" content={imagenAlt}>
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<link rel="preload" href="/fonts/inter-tight-latin.woff2" as="font" type="font/woff2" crossorigin>
<!-- Sin JavaScript no se puede abrir la hoja del menú: en su lugar se muestran los enlaces en línea. -->
<noscript><style>.ds-header__bar{flex-wrap:wrap}.ds-header__nav{display:block;margin-left:0;width:100%}.ds-header__list{flex-wrap:wrap}.ds-menu-btn{display:none}</style></noscript>
</head>
<body>
<div class="ds-page t-body">
<Header actual={actual} />
<slot />
<Footer />
</div>
<Contacto />
<script>import '../scripts/contacto.js';import '../scripts/navegacion.js';</script>
</body>
</html>
