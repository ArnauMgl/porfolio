---
// Plantilla base de todas las páginas: <head>, cabecera, contenido y pie.
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/tokens.css';
import '../styles/components.css';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  actual?: 'inicio' | 'trabajo' | 'caso' | 'sobre-mi';
}
const { title, description, actual } = Astro.props;
---
<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@500;600;700&display=swap" rel="stylesheet">
</head>
<body>
<div class="ds-page t-body">
<Header actual={actual} />
<slot />
<Footer />
</div>
</body>
</html>
