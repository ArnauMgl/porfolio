---
// Plantilla de las páginas del Lab (/lab/ y /lab/<slug>/): Base con el tema oscuro y la regla del interruptor LAB_PUBLIC.
//   LAB_PUBLIC=false (Lab oculto; por defecto es público): <meta robots noindex, nofollow>, sin canonical ni og:url. El enlace del menú y el sitemap
//   los decide el resto del proyecto con el mismo interruptor (lib/lab/flag.js).
import Base from './Base.astro';
import '../styles/lab.css';
import { labPublico } from '../../lib/lab/flag.js';

interface Props {
  title: string;
  description: string;
  // Solo en la página de una entrada: fecha (AAAA-MM-DD) para article:published_time.
  publicadoEn?: string;
}
const { title, description, publicadoEn } = Astro.props;
const oculto = !labPublico();
---
<Base title={title} description={description} actual="lab" tema="lab" noindex={oculto} nofollow={oculto} publicadoEn={publicadoEn} emailContacto>
<slot />
</Base>
